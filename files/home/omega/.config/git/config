[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[alias]
	a = "add"
	alias = "config --get-regexp ^alias"
	b = "branch"
	ci = "commit -m"
	co = "checkout"
	d = "diff"
	f = "fetch"
	l = "log --all --graph --pretty=format:'%C(magenta)%h %C(white) %an %ar%C(auto) %D%n%s%n'"
	m = "merge"
	p = "pull"
	pf = "push --force-with-lease"
	ps = "push"
	s = "status"
	sl = "stash list"
	sp = "stash pop"
	sps = "stash push ."
	ss = "submodule status"
	su = "submodule update --init --merge --recursive --remote"

[apply]
	whitespace = "error"

[branch]
	sort = "-committerdate"

[core]
	compression = 9
	preloadindex = true
	whitespace = "blank-at-eof,blank-at-eol,space-before-tab,trailing-space,tabwidth=2"

[credential]
	helper = "libsecret"

[delta]

[init]
	defaultBranch = "main"

